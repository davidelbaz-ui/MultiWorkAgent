# Copy to .env and adjust. Core variables for local dev and production.

APP_ENV=development
FLASK_SECRET_KEY=dev-change-me-in-production
FLASK_DEBUG=1
PORT=5000

SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
FORCE_HTTPS=0
TRUST_PROXY=0

LOG_LEVEL=DEBUG
LOG_JSON=0

RATE_LIMIT_ENABLED=1
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=240

# Public site URL — must match OAuth redirect URIs exactly
# Local: http://127.0.0.1:5000
# Vercel production (OAuth redirects): https://multiworkagent.vercel.app
APP_BASE_URL=http://127.0.0.1:5000

# Login OAuth (Google Cloud) — see AUTH_LOGIN.md
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

INTEGRATION_ENCRYPTION_KEY=

AGENT_PROVIDER=gemini
AGENT_API_KEY=
GEMINI_API_KEY=
AGENT_MODEL=gemini-3.8-flash
AGENT_MODEL_FALLBACK=gemini-2.5-flash
AGENT_MOCK=0
FREE_TIER_MONTHLY_RUNS=5

SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
