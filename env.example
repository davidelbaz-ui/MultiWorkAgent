# Copy to .env and adjust. See docs/PRODUCTION_GO_LIVE.md for Vercel production.

APP_ENV=development
FLASK_SECRET_KEY=dev-change-me-in-production
FLASK_DEBUG=1
PORT=5000

SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
FORCE_HTTPS=0
TRUST_PROXY=0

LOG_LEVEL=DEBUG
LOG_JSON=0

RATE_LIMIT_ENABLED=1
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=240

# Public site URL — must match OAuth redirect URIs exactly
# Local: http://127.0.0.1:5000
# Production: https://multiworkagent.com
APP_BASE_URL=http://127.0.0.1:5000

# Login OAuth — see AUTH_LOGIN.md
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=

INTEGRATION_ENCRYPTION_KEY=

# Agent — Claude production: AGENT_PROVIDER=anthropic + ANTHROPIC_API_KEY
AGENT_PROVIDER=gemini
AGENT_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AGENT_MODEL=gemini-3.8-flash
AGENT_MODEL_FALLBACK=gemini-2.5-flash
AGENT_MOCK=0
FREE_TIER_MONTHLY_RUNS=5

# Stripe SaaS billing (not the Stripe business integration OAuth)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_MAX_MONTHLY_PRICE_ID=
STRIPE_MAX_ANNUAL_PRICE_ID=
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=
# Optional hosted Checkout links if price IDs are empty — see docs/STRIPE_BILLING.md
# STRIPE_CHECKOUT_URL_STARTER=
# BILLING_DEV_MOCK=1

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/multiworkagent

ADMIN_EMAIL=
ADMIN_PASSWORD=
