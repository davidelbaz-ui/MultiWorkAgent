# Agent (Gemini default — set AGENT_PROVIDER=anthropic for Claude)
AGENT_PROVIDER=gemini
AGENT_API_KEY=
GEMINI_API_KEY=
AGENT_MODEL=gemini-3.8-flash
AGENT_MODEL_FALLBACK=gemini-2.5-flash
AGENT_MOCK=0
FREE_TIER_MONTHLY_RUNS=5
AGENT_CONCURRENT_MAX=2
AGENT_DAILY_RUN_LIMIT=50

# Billing (Square)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
BILLING_DEV_MOCK=0
