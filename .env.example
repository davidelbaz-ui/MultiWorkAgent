# Core
APP_ENV=development
FLASK_SECRET_KEY=dev-change-me-in-production
FLASK_DEBUG=1
PORT=5000

# HTTPS / cookies (set SESSION_COOKIE_SECURE=1 behind TLS)
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax
FORCE_HTTPS=0
TRUST_PROXY=0

# Logging
LOG_LEVEL=DEBUG
LOG_JSON=0

# Rate limits (per IP, rolling 60s window)
RATE_LIMIT_ENABLED=1
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SIGNUP_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=240

# Integration credential encryption (required for production)
INTEGRATION_ENCRYPTION_KEY=

# PostgreSQL (required) — password is in the URL
# Local (docker compose): postgresql://postgres:postgres@127.0.0.1:5432/multiworkagent
# Vercel Postgres: use POSTGRES_URL from the Vercel dashboard (maps to DATABASE_URL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/multiworkagent
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/multiworkagent_test

# Public URL — local: http://127.0.0.1:5000 | Vercel: https://multiworkagent.vercel.app
# APP_BASE_URL=

# Contact support — operator replies via POST /api/support/reply (Bearer token)
# SUPPORT_REPLY_TOKEN=

# Integration OAuth (platform apps). Callback: {APP_BASE_URL}/integrations/oauth/callback
# All 109 catalog integrations ù uncomment and fill as you register each OAuth app.
# Regenerate: PYTHONPATH=. python scripts/gen_env_oauth_example.py
# github (GitHub) [wired]
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

